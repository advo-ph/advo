# Copy to .env.local for local dev (gitignored) or set in deploy env for prod.

# Required — where the frontend talks to the ADVO API
VITE_API_URL=http://localhost:6407        # local dev
# VITE_API_URL=https://api.advo.ph        # production

# Optional — GitHub PAT for reading commit history in the hub
VITE_GITHUB_TOKEN=

# Optional — which API `npm run dev:web` proxies /api to. In dev the client
# always calls a relative /api, so this (not VITE_API_URL) is what a parallel
# lane running its own API on another port needs to set.
# VITE_API_PROXY_TARGET=http://127.0.0.1:6407
