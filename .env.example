# Copy to .env.local for local dev (gitignored) or set in deploy env for prod.

# Required — where the frontend talks to the ADVO API
VITE_API_URL=http://localhost:6407        # local dev
# VITE_API_URL=https://api.advo.ph        # production

# Optional — GitHub PAT for reading commit history in the hub
VITE_GITHUB_TOKEN=

# Optional — which API `npm run dev:web` proxies /api to. In dev the client
# always calls a relative /api, so this (not VITE_API_URL) is what a parallel
# lane running its own API on another port needs to set.
# VITE_API_PROXY_TARGET=http://127.0.0.1:6407

# ─── API (apps/api) ─────────
# Full list and defaults live in apps/api/.env.example.

# Preview hosting for "Show Client Now": which adapter produces the preview URL.
# `manual` (default) uses the preview_url the team pastes onto the project —
# no credential, no network, today's behaviour. `herenow` uploads the project's
# already-built static artifact and returns the URL here.now serves it from.
# Setting herenow without a key is safe: it falls back to manual.
# PREVIEW_HOST_PROVIDER=manual
# HERENOW_API_KEY=
# HERENOW_API_URL=https://api.here.now

# Cloudflare Pages preview deploy. Set PREVIEW_HOST_PROVIDER=cloudflare to use it.
# The token needs the 'Cloudflare Pages: Edit' permission on the account. Unlike the
# here.now key, this one ADVO can issue for itself. Create the Pages project once
# (dashboard or `npx wrangler pages project create <name>`) before the first deploy.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_PAGES_PROJECT=
