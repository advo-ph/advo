# Database
DATABASE_URL=postgresql://advo:changeme@localhost:5432/advo

# Auth
JWT_SECRET=generate-a-64-char-random-string
JWT_REFRESH_SECRET=generate-a-different-64-char-random-string

# Email (Resend or SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Or SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@advo.ph
# SMTP_PASS=changeme

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=generate-a-random-string
GITHUB_ORG=advo-ph

# praud → ADVO (passcode `advo` on praud.bygelo.com)
PRAUD_IMPORT_SECRET=
# Optional. When unset, imports land on a project titled Inbox (created if missing).
ADVO_INBOX_PROJECT_ID=

# Plaud consumer JWT (file-id import + GET /api/meeting/plaud). Share-URL import works without this.
# PLAUD_TOKEN=
# PLAUD_AUTH_FILE=C:\Users\you\.piper\plaud-auth.json
# PLAUD_API_HOST=https://api-apse1.plaud.ai
# Seconds between ADVO-folder probes. 0 = off. Default 60.
# PLAUD_POLL_SECOND=60

# Claude — contract review, meeting → tasks, timeline suggestion, revision-note
# polish, and proposal body copy. Every one of those falls back to a heuristic /
# template path when this is unset, so the app works without it.
ANTHROPIC_API_KEY=

# Cloudflare
CLOUDFLARE_TOKEN=xxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxx

# Server
PORT=6407
NODE_ENV=development
UPLOAD_DIR=./uploads
API_URL=http://localhost:6407
FRONTEND_URL=http://localhost:6400
