# Database
DATABASE_URL=postgresql://advo:changeme@localhost:5432/advo

# Auth
JWT_SECRET=generate-a-64-char-random-string
JWT_REFRESH_SECRET=generate-a-different-64-char-random-string

# Email (Resend or SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Resend dashboard → Webhooks → add https://api.advo.ph/api/campaign/esp-webhook with
# the email.bounced + email.complained events, then paste its signing secret here.
# WITHOUT THIS the endpoint answers 503 and hard bounces / complaints never reach the
# suppression list — the sending domain burns while every dashboard looks green.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Or SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@advo.ph
# SMTP_PASS=changeme

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=generate-a-random-string
GITHUB_ORG=advo-ph

# praud → ADVO (passcode `advo` on praud.bygelo.com)
PRAUD_IMPORT_SECRET=
# Optional. When unset, imports land on a project titled Inbox (created if missing).
ADVO_INBOX_PROJECT_ID=

# Plaud consumer JWT (file-id import + GET /api/meeting/plaud). Share-URL import works without this.
# PLAUD_TOKEN=
# PLAUD_AUTH_FILE=C:\Users\you\.piper\plaud-auth.json
# PLAUD_API_HOST=https://api-apse1.plaud.ai
# Seconds between ADVO-folder probes. 0 = off. Default 60.
# PLAUD_POLL_SECOND=60

# Claude — contract review, meeting → tasks, timeline suggestion, revision-note
# polish, and proposal body copy. Every one of those falls back to a heuristic /
# template path when this is unset, so the app works without it.
ANTHROPIC_API_KEY=

# Cloudflare Pages — the preview-hosting adapter selected by
# PREVIEW_HOST_PROVIDER=cloudflare (see the Preview hosting block below).
# The token needs the "Cloudflare Pages: Edit" permission, and the Pages project
# must exist before the first deploy.
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxx
CLOUDFLARE_PAGES_PROJECT=xxxxxxxxxxxx

# Server
PORT=6407
NODE_ENV=development
UPLOAD_DIR=./uploads
API_URL=http://localhost:6407
FRONTEND_URL=http://localhost:6400

# ─── Outreach transport (mass campaign send) ─────────
# DELIBERATELY SEPARATE from the transactional mailer above, which carries client
# magic-links. A deliverability hit on cold outreach must not take client logins with
# it — so outreach gets its own credentials and its own sending subdomain.
# Campaign sending is REFUSED when these are unset; it never falls back to the
# transactional transport.
# OUTREACH_SMTP_HOST=smtp.example.com
# OUTREACH_SMTP_PORT=587
# OUTREACH_SMTP_USER=
# OUTREACH_SMTP_PASS=
# OUTREACH_FROM=ADVO <hello@outreach.advo.ph>

# ─── Preview hosting ("Show Client Now") ─────────
# Which adapter turns a project into a previewable URL.
#   manual   (default) the team pastes preview_url onto the project — today's
#            behaviour, no credential, no network.
#   herenow  uploads the project's already-built static artifact and returns the
#            URL here.now serves it from.
# Leave unset for manual. Setting herenow WITHOUT a key is safe: the adapter
# falls back to manual rather than failing the endpoint.
# PREVIEW_HOST_PROVIDER=manual
# HERENOW_API_KEY=
# Override only if here.now moves off its default API host.
# HERENOW_API_URL=https://api.here.now
#
# The DKIM selector the outreach ESP issued. `npm run outreach:preflight` looks up
# <selector>._domainkey.<outreach domain>, and there is no safe default — a guessed
# selector checks the wrong name and reports a key that was never missing.
# OUTREACH_DKIM_SELECTOR=resend
#
# Setting the five above is NOT clearance to send. Configuration says the transport
# exists; it says nothing about whether the receiving world will accept the mail. Run
#
#   npm run outreach:preflight
#
# to resolve SPF, DKIM and DMARC for the outreach domain. It records the verdict to
# docs/outreach-preflight.json, and campaign sending stays refused until that verdict
# passes for this exact domain (and is under 30 days old).

# ─── Payment rail (migration 022) ─────────────────────
# Which adapter turns an invoice into something a client can pay.
#   manual   (default) records the collectable and returns NO checkout URL —
#            exactly what the business does today: collect over GCash or bank
#            transfer and settle it from admin. No credential, no network.
#   paymongo the intended primary. Cards + GCash + Maya + GrabPay, PH-domiciled.
#            BLOCKED on merchant review, which is what the /terms /privacy
#            /refund /dispute disclosure work exists to unblock.
#   xendit   the second rail, so a merchant-review delay on one provider cannot
#            hold collection hostage.
# Naming a provider WITHOUT its credential is safe: the adapter falls back to
# manual and logs that it did, rather than failing the endpoint.
# PAYMENT_PROVIDER=manual
#
# PayMongo dashboard → Developers → API keys. The SECRET key, not the public one.
# PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxx
# PayMongo dashboard → Developers → Webhooks. Signs the `Paymongo-Signature`
# header. WITHOUT THIS EVERY CALLBACK IS REFUSED — and the symptom is invoices
# that silently never settle, which looks exactly like clients who have not paid.
# Point the webhook at: https://api.advo.ph/api/payment/webhook/paymongo
# PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxx
#
# Xendit dashboard → Settings → API keys (secret, with Money-in write access).
# XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxx
# Xendit dashboard → Settings → Webhooks → verification token. Echoed in the
# `x-callback-token` header; without it every Xendit callback is refused.
# Point the callback at: https://api.advo.ph/api/payment/webhook/xendit
# XENDIT_CALLBACK_TOKEN=

# ─── Message channels (migration 023) ─────────────────
# SMS / Viber / Messenger, inbound and outbound.
#
# WHY OUTBOUND EXISTS: the deemed-approval notice (021) is a 15-business-day
# contractual clock whose force depends on the client receiving it — and the
# only channel carrying it was transactional email, which had NO TRANSPORT in
# prod for months and failed silently the whole time.
#
# WHY INBOUND EXISTS: docs/ROADMAP.md was assembled by a human reading a
# Messenger export. The change-order process and the revision cap both need a
# paper trail of what the client asked for and when, and it is on someone's phone.
#
# CONSENT IS ENFORCED IN CODE. A contact_channel with no consent_at is REFUSED
# before any provider is reached. The ~5K scraped clinic numbers are personal
# data under RA 10173 with no consent basis; this is what stops the list from
# becoming an SMS blast. Setting a key below does not bypass it.
#
# Which SMS gateway serves the `sms` channel. Default `log` RECORDS the message
# and refuses to claim it was sent — a transport that reports success without a
# transport is the failure that hid the 2026-08-29 mail outage.
# SMS_PROVIDER=log
#
# Semaphore (semaphore.co) — PH SMS. Sender name must be pre-registered with
# them; unset uses their shared default rather than failing.
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=ADVO
#
# Movider (movider.co) — the PH SMS alternative. Both keys or neither.
# MOVIDER_API_KEY=
# MOVIDER_API_SECRET=
#
# Semaphore does not sign inbound callbacks, so a shared secret in the
# `x-advo-inbound-secret` header is the only control available. Without it every
# inbound SMS is stored UNVERIFIED (stored, flagged — never silently trusted).
# SMS_INBOUND_SECRET=
#
# Viber Business Messages. The auth token both sends AND verifies inbound
# signatures (Viber offers no separate signing key).
# VIBER_AUTH_TOKEN=
# VIBER_SENDER_NAME=ADVO
#
# Facebook Messenger. Point the webhook at:
#   https://api.advo.ph/api/message/webhook/messenger
# MESSENGER_PAGE_TOKEN=   # page access token — sends
# MESSENGER_APP_SECRET=   # signs X-Hub-Signature-256 on inbound
# MESSENGER_VERIFY_TOKEN= # echoed during the one-time subscription handshake

# ─── External read-through connectors ─────────────────
# Figma, Google Drive, Google Calendar. READ-THROUGH ONLY: nothing is mirrored
# into a local table, because a mirror needs a sync schedule, a conflict policy
# and a deletion policy — and a stale one shows a client a design that was
# deleted last week, with no error anywhere to explain it.
#
# SERVER-SIDE ONLY. Note that NONE of these is prefixed VITE_, and that is
# load-bearing: audit item S4 was VITE_GITHUB_TOKEN and VITE_CLOUDFLARE_TOKEN
# compiled into the browser bundle and readable in devtools, in production.
# A Figma PAT or a Google service-account key is a strictly worse version of
# that bug. If you ever find yourself adding VITE_ to one of these, stop.
#
# Unset is safe: the connector reports "not configured" and fetches nothing.
# It never throws and never fabricates sample data.
#
# Figma → Settings → Security → Personal access tokens. Needs file:read only.
# FIGMA_TOKEN=
#
# Google: a SERVICE ACCOUNT key, not OAuth. One JSON key, pasted as one line.
#   1. console.cloud.google.com → create a project
#   2. Enable the Google Drive API and the Google Calendar API
#   3. Create a service account, then a JSON key for it
#   4. Share the specific Drive folder / calendar with the service account's
#      client_email — a 404 from either API almost always means this step
#      was missed
# Chosen over OAuth deliberately: no per-user consent flow, no refresh-token
# storage, and the client can UNDO the share themselves without involving ADVO.
# The grant is also narrower — the account sees only what was shared with it.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
